{
  "name": "silverforge-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static, non-custodial token creation frontend for Ethereum, BNB Smart Chain and Solana.",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:contract": "node scripts/compile-contract.mjs",
    "predev": "npm run build:contract",
    "prebuild": "npm run build:contract",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@solana/web3.js": "1.99.0",
    "ethers": "6.17.0",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@openzeppelin/contracts": "5.6.1",
    "solc": "0.8.38",
    "vite": "6.4.5"
  },
  "overrides": {
    "jayson": "5.0.0",
    "tmp": "0.2.7"
  }
}
